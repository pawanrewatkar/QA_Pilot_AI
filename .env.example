# QA Pilot AI — environment template
# Copy to .env.local for local development. Every value is optional:
# the app runs fully locally with no external services or API keys.
# NEVER commit real secrets. .env* files (except this one) are git-ignored.

# ---------------------------------------------------------------------------
# Identity and access (lib/auth/identity.ts)
# ---------------------------------------------------------------------------
# "local" (default): single local operator, for development on your own machine. Every project,
# run, bug, report and file is owned by that operator. Refused on Vercel. For a production build
# (`npm run build && npm start`) it also requires QA_PILOT_LOCAL_MODE=true.
# "supabase": Supabase Auth (email + password). Every protected page, route and action requires a
# verified session for a confirmed email that is currently in AUTH_ALLOWED_EMAILS. If any value
# below is missing or invalid the app fails closed (no access); it never falls back to local mode.
AUTH_PROVIDER=local
# QA_PILOT_LOCAL_MODE=true

# Supabase Auth (only read when AUTH_PROVIDER=supabase). Values are placeholders.
# Project URL and the publishable (or legacy anon) key are public by design; they are not secrets.
# Never put a secret / service-role key (sb_secret_...) here: it is rejected, and none is needed.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
# Legacy anon key, read only when the publishable key is unset:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<legacy-anon-key>
# Public origin of this app (no path), used for email links and redirects instead of the Host header.
# NEXT_PUBLIC_SITE_URL=https://<your-domain>
# Server-only allow-list: comma-separated emails and/or "@domain" entries. Enforced on registration
# and on every request. Empty or missing = nobody can register or sign in. Never use NEXT_PUBLIC_.
# AUTH_ALLOWED_EMAILS=you@example.com,@example.org

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Active provider. Only "local" (SQLite) is implemented.
DATABASE_PROVIDER=local
# Path to the SQLite file (relative to the project root). Created automatically.
DATABASE_PATH=./data/qa-pilot.db

# Future: Supabase Postgres (not implemented — data stays in SQLite; setting these has no effect)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Storage (screenshots, uploaded documents, generated reports)
# ---------------------------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_PATH=./data/storage
# Maximum upload size for reference documents, in megabytes.
MAX_UPLOAD_MB=10
# External Test Case Testing: workbooks can be read by local path only from this folder.
EXTERNAL_TEST_CASES_DIR=./data/test-cases

# ---------------------------------------------------------------------------
# AI (optional, future). The app works without AI.
# ---------------------------------------------------------------------------
# "local" = deterministic rule-based analysis, no network calls.
AI_PROVIDER=local
# ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Future integrations (not implemented yet — setting these has no effect)
# ---------------------------------------------------------------------------
# FIGMA_ACCESS_TOKEN=
# PAGESPEED_API_KEY=
# EMAIL_PROVIDER=local
# SMTP_URL=
